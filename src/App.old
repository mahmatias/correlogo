import { useState, useEffect } from 'react';
import { Play, LogOut, RefreshCw, CheckCircle, Circle } from 'lucide-react';
import { WorkoutPlan, formatDuration, formatTotalDuration } from './types';
import WorkoutTracker from './components/WorkoutTracker';
import ImportPlan from './components/ImportPlan';
import Signup from './components/Signup';
import Login from './components/Login';
import { getAuth, getDb } from './lib/firebase';
import { onAuthStateChanged, User, signOut } from 'firebase/auth';
import { doc, getDoc, setDoc } from 'firebase/firestore';

export default function App() {
  const [user, setUser] = useState<User | null>(null);
  const [showSignup, setShowSignup] = useState(false);
  const [plans, setPlans] = useState<WorkoutPlan[]>([]);
  const [activePlan, setActivePlan] = useState<{plan: WorkoutPlan, mode: 'treadmill' | 'outdoor'} | null>(null);
  const [workoutToStart, setWorkoutToStart] = useState<WorkoutPlan | null>(null);
  const [initialized, setInitialized] = useState(false);
  const [isDarkMode, setIsDarkMode] = useState(false);
  const [expandedPlans, setExpandedPlans] = useState<Set<string>>(new Set());

  useEffect(() => {
    onAuthStateChanged(getAuth(), async (user) => {
      setUser(user);
      if (user) {
        // Load plans & settings
        const plansDoc = await getDoc(doc(getDb(), 'users', user.uid, 'data', 'plans'));
        if (plansDoc.exists()) setPlans(plansDoc.data().plans);
        
        const settingsDoc = await getDoc(doc(getDb(), 'users', user.uid, 'data', 'settings'));
        if (settingsDoc.exists()) {
            setIsDarkMode(settingsDoc.data().isDarkMode);
        } else {
            // Initial system detection
            setIsDarkMode(window.matchMedia('(prefers-color-scheme: dark)').matches);
        }
        setInitialized(true);
      } else {
        setPlans([]);
        setInitialized(true);
      }
    });
  }, []);

  const startWorkout = (plan: WorkoutPlan) => {
    setWorkoutToStart(plan);
  };

  const confirmWorkoutMode = (mode: 'treadmill' | 'outdoor') => {
    if (workoutToStart) {
      setActivePlan({ plan: workoutToStart, mode });
      setWorkoutToStart(null);
    }
  };

  const toggleDarkMode = async () => {
    const newDarkMode = !isDarkMode;
    console.log("Toggling dark mode to:", newDarkMode);
    setIsDarkMode(newDarkMode);
    if (user) {
        try {
            await setDoc(doc(getDb(), 'users', user.uid, 'data', 'settings'), { isDarkMode: newDarkMode });
            console.log("Theme preference saved to DB.");
        } catch (e) {
            console.error("Error saving theme preference:", e);
        }
    }
  };

  const togglePlanExpansion = (id: string) => {
    const newExpanded = new Set(expandedPlans);
    if (newExpanded.has(id)) {
      newExpanded.delete(id);
    } else {
      newExpanded.add(id);
    }
    setExpandedPlans(newExpanded);
  };

  const handleImport = async (newPlans: WorkoutPlan[]) => {
    const updatedPlans = [...plans, ...newPlans];
    setPlans(updatedPlans);
    console.log("Saving plans to Firestore:", updatedPlans);
    if (user) {
        try {
            await setDoc(doc(getDb(), 'users', user.uid, 'data', 'plans'), { plans: updatedPlans });
            console.log("Plans saved successfully.");
        } catch (e) {
            console.error("Error saving plans:", e);
        }
    }
  };

  const toggleComplete = async (id: string) => {
    const updatedPlans = plans.map(p => p.id === id ? {...p, isCompleted: !p.isCompleted} : p);
    setPlans(updatedPlans);
    if (user) {
        try {
            await setDoc(doc(getDb(), 'users', user.uid, 'data', 'plans'), { plans: updatedPlans });
        } catch (e) {
            console.error("Error saving plan completion:", e);
        }
    }
  }

  const handleLogout = () => {
    signOut(getAuth());
  };

  const calculateTotalDuration = (plan: WorkoutPlan) => {
    return plan.steps.reduce((acc, step) => acc + step.durationSeconds, 0);
  }

  return (
    <div className={`min-h-screen ${isDarkMode ? 'dark bg-gray-950' : 'bg-gray-50'}`}>
      <main className="w-full max-w-lg mx-auto p-4 pt-8">
        {!user ? (
          showSignup ? <Signup /> : <Login onSignupClick={() => setShowSignup(true)} />
        ) : (
          <>
            <div className="flex justify-between items-center mb-8">
              <h1 className={`text-2xl font-bold ${isDarkMode ? 'text-white' : 'text-gray-900'}`}>Corre Logo 🏃</h1>
              <div className='flex gap-2'>
              <button 
                onClick={handleLogout}
                className={`p-2 rounded-full ${isDarkMode ? 'bg-gray-800 text-red-300' : 'bg-gray-200 text-red-700'}`}
              >
                <LogOut size={20} />
              </button>
              <button 
                onClick={toggleDarkMode}
                className={`p-2 rounded-full ${isDarkMode ? 'bg-gray-800 text-yellow-300' : 'bg-gray-200 text-gray-700'}`}
              >
                {isDarkMode ? '☀️' : '🌙'}
              </button>
              </div>
            </div>
            
            {workoutToStart && (
              <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
                <div className={`p-6 rounded-2xl shadow-xl w-full max-w-sm ${isDarkMode ? 'bg-gray-900' : 'bg-white'}`}>
                    <h2 className={`text-xl font-bold mb-4 ${isDarkMode ? 'text-white' : 'text-gray-900'}`}>Escolha a modalidade</h2>
                    <div className="flex gap-4">
                        <button className="flex-1 bg-indigo-600 text-white p-3 rounded-lg" onClick={() => confirmWorkoutMode('outdoor')}>Ar Livre</button>
                        <button className="flex-1 bg-gray-600 text-white p-3 rounded-lg" onClick={() => confirmWorkoutMode('treadmill')}>Esteira</button>
                    </div>
                </div>
              </div>
            )}
            {activePlan ? (
                <WorkoutTracker key={activePlan.plan.id} plan={activePlan.plan} mode={activePlan.mode} onStop={() => setActivePlan(null)} isDarkMode={isDarkMode} markAsCompleted={toggleComplete} />
            ) : (
              <div className={`${isDarkMode ? 'bg-gray-900 border-gray-800' : 'bg-white border-gray-100'} p-8 rounded-2xl shadow-sm border`}>
                <ImportPlan onImport={handleImport} />
                <div className="space-y-4">
                  {plans.length === 0 ? (
                    <p className={`text-center ${isDarkMode ? 'text-gray-500' : 'text-gray-500'}`}>No plans uploaded yet.</p>
                  ) : (
                    plans.map((plan, index) => (
                      <div key={`${plan.id}-${index}`} className={`${isDarkMode ? 'border-gray-800' : 'border-gray-100'} border rounded-lg overflow-hidden ${plan.isCompleted ? 'opacity-50' : ''}`}>
                        <div 
                          className={`flex justify-between items-center p-4 cursor-pointer ${isDarkMode ? 'hover:bg-gray-800' : 'hover:bg-gray-50'}`}
                          onClick={() => togglePlanExpansion(plan.id)}
                        >
                          <div className='flex gap-2 items-center'>
                            <button onClick={(e) => { e.stopPropagation(); toggleComplete(plan.id); }}>
                                {plan.isCompleted ? <CheckCircle className='text-green-500' /> : <Circle className='text-gray-400' />}
                            </button>
                            <span className={`font-medium ${isDarkMode ? 'text-gray-200' : 'text-gray-800'}`}>{plan.name || 'Unnamed Plan'}</span>
                          </div>
                          <div className='flex gap-2 items-center'>
                            <span className='text-xs text-gray-500'>{formatTotalDuration(calculateTotalDuration(plan))}</span>
                            <button 
                                className={`p-2 text-indigo-500 hover:bg-indigo-900 rounded-full ${plan.isCompleted ? 'cursor-not-allowed opacity-30' : ''}`}
                                onClick={(e) => { e.stopPropagation(); if (!plan.isCompleted) startWorkout(plan); }}
                                disabled={plan.isCompleted}
                            >
                                <Play size={20} />
                            </button>
                          </div>
                        </div>
                        {expandedPlans.has(plan.id) && (
                          <div className={`p-4 border-t ${isDarkMode ? 'border-gray-800 text-gray-400' : 'border-gray-100 text-gray-600'} text-sm`}>
                            <h4 className="font-semibold mb-2">Steps:</h4>
                            <ul className="space-y-1">
                              {plan.steps.map((step, idx) => (
                                <li key={idx} className="capitalize">{step.type}: {formatDuration(step.durationSeconds)}min @ { (60/(step.targetPace||1)).toFixed(2) } KM/h (Pace {step.targetPace||0}")</li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    ))
                  )}
                </div>
              </div>
            )}
          </>
        )}
      </main>
    </div>
  );
}
